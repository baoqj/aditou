# Dependencies and package-manager caches (keep dependency lockfiles)
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# Build output and tooling caches
dist/
build/
out/
.vite/
.cache/
*.tsbuildinfo

# Cloudflare local state, databases, and secret bindings
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.sample
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx

# Generated browser checks, screenshots, reports, and coverage
artifacts/
test-results/
playwright-report/
blob-report/
coverage/
.nyc_output/

# Python import tooling caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Runtime logs, local database files, and temporary output
*.log
*.pid
*.pid.lock
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
tmp/
temp/
*.tmp
*.temp

# Operating-system and editor files
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
